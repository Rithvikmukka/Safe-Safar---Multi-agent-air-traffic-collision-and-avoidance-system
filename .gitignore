# ============================================================
# Safe Safar — Multi-Agent Air Traffic Collision Avoidance
# .gitignore
# ============================================================

# ---- OS & Editor Artifacts ----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ---- VS Code ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# ---- JetBrains IDEs ----
.idea/
*.iml

# ---- Node / npm (if dev tooling is added later) ----
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
dist/
build/

# ---- Python (if analysis scripts are added) ----
__pycache__/
*.py[cod]
*.pyo
.env
.venv/
venv/

# ---- Logs ----
*.log

# ---- Local environment / secrets ----
.env
.env.local
.env.*.local

# ---- Temporary & scratch files ----
*.tmp
*.bak
src/_body_temp.html
